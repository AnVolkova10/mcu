{
  "name": "mcu-timeline",
  "private": true,
  "version": "3.0.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview",
