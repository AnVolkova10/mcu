    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.16.0",
    "postprocessing": "^6.39.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "0.186.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.10.1",
